# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection. Use the single DATABASE_URL if your host provides one
# (Render, Railway, Fly, Heroku, Neon, etc all do). Locally you can build it
# from the pieces below instead.
DATABASE_URL=postgres://username:password@localhost:5432/members_only

PGHOST=localhost
PGPORT=5432
PGDATABASE=members_only
PGUSER=username
PGPASSWORD=password

# Set to "true" only when connecting to a host that requires SSL (most
# managed cloud Postgres providers do). Leave "false" for local development.
PG_SSL=false

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# The secret passcodes members/admins must enter to unlock those roles.
MEMBERSHIP_SECRET=cheese_pizza
ADMIN_SECRET=super_secret_admin_code

PORT=3000
NODE_ENV=development
